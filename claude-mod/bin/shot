#!/bin/sh
# Runs the shot binary for this plugin: $SHOT_BIN if set, a local build when
# the plugin sits in a checkout of the repo, a `shot` already on PATH, or the
# release matching this plugin's version, downloaded once.
set -e
VERSION="0.1.3"
REPO="davekiss/shot"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ -n "$SHOT_BIN" ]; then exec "$SHOT_BIN" "$@"; fi
if [ -x "$ROOT/../.build/release/shot" ]; then exec "$ROOT/../.build/release/shot" "$@"; fi
for p in $(command -v -a shot 2>/dev/null); do
  [ "$p" -ef "$0" ] || exec "$p" "$@"
done

DIR="$HOME/Library/Application Support/shot/$VERSION"
BIN="$DIR/shot"
if [ ! -x "$BIN" ]; then
  mkdir -p "$DIR"
  # curl doesn't set the quarantine flag, so Gatekeeper won't block the binary.
  curl -fsSL "https://github.com/$REPO/releases/download/v$VERSION/shot-macos-universal.tar.gz" | tar -xz -C "$DIR" >&2
  chmod +x "$BIN"
fi
exec "$BIN" "$@"
